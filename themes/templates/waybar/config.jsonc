{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,

    "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "tray", "custom/notifications", "custom/clipboard", "network", "pulseaudio", "backlight", "battery", "custom/session"],

    "custom/launcher": {
        "format": "\uf0c9 ",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "{{WAYBAR_WORKSPACE_ACTIVE}}",
            "default": "{{WAYBAR_WORKSPACE_DEFAULT}}"
        }
    },

    "niri/window": {
        "format": " {}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "\uf017 {:%H:%M}",
        "format-alt": "\uf306 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{:%A %d %B %Y}"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "\uf001",
            "mpv": "\uf001",
            "spotify": "\uf1bc",
            "firefox": "\uf269"
        },
        "status-icons": {
            "paused": "\uf04c"
        },
        "max-length": 50
    },

    "custom/notifications": {
        "format": "\uf0f3 {}",
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    },

    "custom/clipboard": {
        "format": "\uf0ea ",
        "on-click": "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy",
        "tooltip": false
    },

    "network": {
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-ethernet": "\uf0ac {ifname}",
        "format-disconnected": "\uf057 Offline",
        "on-click": "nm-connection-editor",
        "on-click-right": "bash -c 'nmcli radio wifi && nmcli radio wifi off || nmcli radio wifi on'"
    },

    "pulseaudio": {
        "format": "\uf028 {volume}%",
        "format-icons": {
            "headphone": "\uf025",
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "format-muted": "\uf6a9 muted",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "\uf185 {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "format-charging": "\uf0e7 {capacity}%",
        "format-full": "\uf240 Full",
        "states": {
            "good": 50,
            "warning": 16,
            "critical": 6
        }
    },

    "custom/session": {
        "format": "\uf011 ",
        "on-click": "wlogout",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
