{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 10,
    "margin-bottom": 0,

    "modules-left": [],
    "modules-center": ["custom/launcher", "niri/workspaces", "clock", "mpris", "custom/notifications", "custom/clipboard", "network", "pulseaudio", "battery", "tray", "custom/session"],
    "modules-right": [],

    "custom/launcher": {
        "format": " ",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "{{WAYBAR_WORKSPACE_ACTIVE}}",
            "default": "{{WAYBAR_WORKSPACE_DEFAULT}}"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %m/%d %H:%M}",
        "tooltip-format": "{:%A %d %B %Y %H:%M}"
    },

    "custom/notifications": {
        "format": " {}",
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    },

    "custom/clipboard": {
        "format": " ",
        "on-click": "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy",
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "",
            "mpv": "",
            "spotify": "",
            "firefox": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 35,
        "tooltip-format": "{player} — {dynamic}",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/media_menu.xml",
        "menu-actions": {
            "play_pause": "playerctl play-pause",
            "previous": "playerctl previous",
            "next": "playerctl next",
            "stop": "playerctl stop"
        }
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " Offline",
        "on-click": "nm-connection-editor",
        "on-click-right": "bash -c 'nmcli radio wifi && nmcli radio wifi off || nmcli radio wifi on'"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "format-muted": " muted",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "format-full": " Full",
        "states": {
            "good": 50,
            "warning": 16,
            "critical": 6
        }
    },

    "custom/session": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 6
    }
}
