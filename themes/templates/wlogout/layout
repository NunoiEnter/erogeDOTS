{
  "label": "lock",
  "action": "qylock-lock",
  "text": "Lock",
  "keybind": "l"
}
{
  "label": "logout",
  "action": "niri msg action quit",
  "text": "Log out",
  "keybind": "e"
}
{
  "label": "suspend",
  "action": "systemctl suspend",
  "text": "Sleep",
  "keybind": "s"
}
{
  "label": "reboot",
  "action": "systemctl reboot",
  "text": "Restart",
  "keybind": "r"
}
{
  "label": "shutdown",
  "action": "systemctl poweroff",
  "text": "Shut down",
  "keybind": "p"
}
