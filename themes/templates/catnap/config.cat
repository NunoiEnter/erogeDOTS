;   /\_/\   catnap config — erogeDOTS
;  ( o.o )  themed, fast, minimal
;   > ^ <

import "distros.cat"

; -- Appearance ---------------------------------------------------------------
$layout       = "inline"
$border_style = "single"
$border_color = {{CATNAP_PRIMARY}}
$distroid     = ""
$stats_margin_top = 0
$graph_width = 15
$location = ""

; -- Stat list ----------------------------------------------------------------
$stats = [
    @{id="username"  icon=''  name="user"      color={{CATNAP_PRIMARY}}}
    @{id="hostname"  icon=''  name="host"      color={{CATNAP_ACCENT}}}
    @{id="uptime"    icon=''  name="up"        color={{CATNAP_PRIMARY}}}
    @{id="separator"}

    @{id="distro"    icon=''  name="os"        color={{CATNAP_PRIMARY}}}
    @{id="kernel"    icon=''  name="ker"       color={{CATNAP_ACCENT}}}
    @{id="separator"}

    @{id="desktop"   icon=''  name="de"        color={{CATNAP_PRIMARY}}}
    @{id="terminal"  icon=''  name="term"      color={{CATNAP_ACCENT}}}
    @{id="shell"     icon='󰞷'  name="sh"       color={{CATNAP_PRIMARY}}}
    @{id="separator"}

    @{id="cpu"       icon=''   name="cpu"       color={{CATNAP_PRIMARY}}}
    @{id="memory"    icon=''   name="mem"       color={{CATNAP_ACCENT}}  graph=true graph_color_fg={{CATNAP_PRIMARY}}}
    @{id="disk_0"    icon=''   name="disk"      color={{CATNAP_PRIMARY}}  graph=true graph_style="ascii" graph_color_fg={{CATNAP_ACCENT}}}
]
