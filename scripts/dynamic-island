#!/usr/bin/env python3
"""dynamic-island — niri-native floating pill widget (Nothing OS style).

Compact: shows time.
Expanded: shows time + media player + CPU/RAM + brightness.
Toggle via left-click or scroll. Auto-collapse after 5s idle.
"""

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
try:
    gi.require_version("Gtk4LayerShell", "1.0")
    import Gtk4LayerShell as LayerShell
    HAS_LAYER_SHELL = True
except (ImportError, ValueError):
    HAS_LAYER_SHELL = False

from gi.repository import Gtk, Gdk, GLib
import subprocess
import os
import time
import signal
import sys

# ── Config ────────────────────────────────────────────────────────────

PILL_HEIGHT = 36
PILL_PAD_X = 24
PILL_MARGIN_TOP = 8
AUTO_COLLAPSE_SEC = 5
POLL_MEDIA_MS = 800
POLL_SYS_MS = 2000

# ── Fallback colors (overridden by theme env) ─────────────────────────

BG = "#1a1a2e"
FG = "#e0e0e0"
ACCENT = "#bb86fc"
DIM = "#666680"


def load_theme_colors():
    """Load colors from theme env file if present."""
    global BG, FG, ACCENT, DIM
    env_path = os.path.expanduser("~/.config/theme/env")
    if not os.path.isfile(env_path):
        return
    try:
        with open(env_path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("export "):
                    line = line[7:]
                if "=" in line:
                    k, v = line.split("=", 1)
                    v = v.strip().strip('"').strip("'")
                    k = k.strip()
                    if k == "COLOR_BG":
                        BG = v
                    elif k == "COLOR_FG":
                        FG = v
                    elif k == "COLOR_PRIMARY":
                        ACCENT = v
                    elif k == "COLOR_DIM":
                        DIM = v
    except Exception:
        pass


# ── Helpers ───────────────────────────────────────────────────────────

def run(cmd, timeout=1.0):
    """Run a command, return stdout stripped or None."""
    try:
        r = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout
        )
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def read_cpu():
    """Return CPU usage percent (two-sample delta)."""
    try:
        with open("/proc/stat") as f:
            parts = f.readline().split()
        vals = list(map(int, parts[1:8]))
        idle = vals[3] + vals[4]  # idle + iowait
        total = sum(vals)
        time.sleep(0.15)
        with open("/proc/stat") as f:
            parts = f.readline().split()
        vals2 = list(map(int, parts[1:8]))
        idle2 = vals2[3] + vals2[4]
        total2 = sum(vals2)
        dtotal = total2 - total
        didle = idle2 - idle
        return round((1 - didle / max(dtotal, 1)) * 100, 1)
    except Exception:
        return 0.0


def read_ram():
    """Return RAM usage percent."""
    try:
        with open("/proc/meminfo") as f:
            info = {}
            for line in f:
                parts = line.split()
                info[parts[0].rstrip(":")] = int(parts[1])
        total = info["MemTotal"]
        avail = info.get("MemAvailable", info.get("MemFree", 0))
        used = total - avail
        return round(used / max(total, 1) * 100, 1)
    except Exception:
        return 0.0


def read_brightness():
    """Return brightness percent or None."""
    base = "/sys/class/backlight"
    if not os.path.isdir(base):
        return None
    try:
        dev = os.listdir(base)[0]
        cur = int(open(f"{base}/{dev}/brightness").read().strip())
        mx = int(open(f"{base}/{dev}/max_brightness").read().strip())
        return round(cur / max(mx, 1) * 100)
    except Exception:
        return None


def read_media():
    """Return (title, artist, status) or None."""
    status = run(["playerctl", "status"])
    if not status or status == "No players found":
        return None
    title = run(["playerctl", "metadata", "title"]) or ""
    artist = run(["playerctl", "metadata", "artist"]) or ""
    return (title, artist, status)


def fmt_time():
    return time.strftime("%H:%M")


def css_provider(bg, fg, accent, dim):
    css = f"""
    window, .island {{
        background: transparent;
    }}
    .pill {{
        background-color: {bg};
        border-radius: 18px;
        padding: 0 {PILL_PAD_X}px;
        min-height: {PILL_HEIGHT}px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.4);
        transition: all 300ms ease;
    }}
    .pill:hover {{
        background-color: {bg}ee;
    }}
    .time {{
        color: {fg};
        font-size: 15px;
        font-weight: 600;
        font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
        min-width: 52px;
    }}
    .media-title {{
        color: {accent};
        font-size: 13px;
        font-weight: 600;
        font-family: "JetBrainsMono Nerd Font", sans-serif;
    }}
    .media-artist {{
        color: {dim};
        font-size: 11px;
        font-family: "JetBrainsMono Nerd Font", sans-serif;
    }}
    .sep {{
        color: {dim};
        font-size: 14px;
        margin: 0 4px;
    }}
    .stat {{
        color: {fg};
        font-size: 12px;
        font-family: "JetBrainsMono Nerd Font", monospace;
    }}
    .bright-icon {{
        color: {accent};
        font-size: 13px;
    }}
    """
    provider = Gtk.CssProvider()
    provider.load_from_string(css)
    return provider


# ── Main Widget ───────────────────────────────────────────────────────

class DynamicIsland(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.erogedots.dynamicisland")
        self.expanded = False
        self.last_activity = 0
        self._prev_media = None

    def do_activate(self):
        load_theme_colors()

        # Layer shell
        if HAS_LAYER_SHELL:
            LayerShell.init()
        self.win = Gtk.ApplicationWindow.new(self)
        if HAS_LAYER_SHELL:
            LayerShell.set_namespace(self.win, "dynamic-island")
            LayerShell.set_layer(self.win, LayerShell.Layer.TOP)
            LayerShell.set_anchor(self.win, True, True, False, True)  # top center
            LayerShell.set_margin(self.win, LayerShell.Edge.TOP, PILL_MARGIN_TOP)
            LayerShell.set_exclusive_zone(self.win, -(PILL_HEIGHT + PILL_MARGIN_TOP))
            LayerShell.set_keyboard_interactivity(self.win, False)

        self.win.set_decorated(False)
        self.win.set_app_paintable(True)
        self.win.set_skip_taskbar_hint(True)
        self.win.set_skip_pager_hint(True)

        # Visual (transparent bg)
        visual = self.win.get_visual()
        if visual and visual.is_rgba():
            self.win.set_visual(visual)

        # CSS
        screen = Gdk.Display.get_default()
        if screen:
            css = css_provider(BG, FG, ACCENT, DIM)
            Gtk.StyleContext.add_provider_for_display(
                screen, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        # Build UI
        self._build_ui()

        # Events
        self.win.connect("destroy", self._on_destroy)
        self.win.add_controller(self._click_gesture())
        self.win.add_controller(self._scroll_gesture())

        self.win.present()

        # Poll timers
        GLib.timeout_add(POLL_MEDIA_MS, self._poll_media)
        GLib.timeout_add(POLL_SYS_MS, self._poll_sys)
        self._tick_id = GLib.timeout_add(1000, self._tick)

        self._poll_media()
        self._poll_sys()
        self._tick()

    def _build_ui(self):
        self.pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.pill.add_css_class("pill")

        # Time
        self.time_label = Gtk.Label(label=fmt_time())
        self.time_label.add_css_class("time")
        self.pill.append(self.time_label)

        # Expanded info container
        self.info_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.info_box.set_visible(False)

        self.sep1 = Gtk.Label(label="·")
        self.sep1.add_css_class("sep")
        self.info_box.append(self.sep1)

        # Media
        self.media_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.media_title = Gtk.Label()
        self.media_title.add_css_class("media-title")
        self.media_title.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        self.media_title.set_max_width_chars(30)
        self.media_title.set_xalign(0)
        self.media_box.append(self.media_title)

        self.media_artist = Gtk.Label()
        self.media_artist.add_css_class("media-artist")
        self.media_artist.set_ellipsize(3)
        self.media_artist.set_max_width_chars(30)
        self.media_artist.set_xalign(0)
        self.media_box.append(self.media_artist)
        self.info_box.append(self.media_box)

        self.sep2 = Gtk.Label(label="·")
        self.sep2.add_css_class("sep")
        self.info_box.append(self.sep2)

        # System stats
        self.sys_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cpu_label = Gtk.Label()
        self.cpu_label.add_css_class("stat")
        self.sys_box.append(self.cpu_label)

        self.ram_label = Gtk.Label()
        self.ram_label.add_css_class("stat")
        self.sys_box.append(self.ram_label)

        self.bright_label = Gtk.Label()
        self.bright_label.add_css_class("bright-icon")
        self.sys_box.append(self.bright_label)

        self.info_box.append(self.sys_box)

        self.pill.append(self.info_box)
        self.win.set_child(self.pill)

    def _click_gesture(self):
        gesture = Gtk.GestureClick.new()
        gesture.connect("released", self._on_click)
        return gesture

    def _scroll_gesture(self):
        controller = Gtk.EventControllerScroll.new(
            Gtk.EventControllerScrollFlags.VERTICAL
        )
        controller.connect("scroll", self._on_scroll)
        return controller

    def _on_click(self, gesture, n_press, x, y):
        self._toggle()

    def _on_scroll(self, controller, dx, dy):
        if dy > 0:
            self._expand()
        elif dy < 0:
            self._collapse()
        return True

    def _toggle(self):
        if self.expanded:
            self._collapse()
        else:
            self._expand()

    def _expand(self):
        self.expanded = True
        self.info_box.set_visible(True)
        self.last_activity = time.time()

    def _collapse(self):
        self.expanded = False
        self.info_box.set_visible(False)

    def _tick(self):
        self.time_label.set_label(fmt_time())
        # Auto-collapse
        if self.expanded and (time.time() - self.last_activity) > AUTO_COLLAPSE_SEC:
            self._collapse()
        return True

    def _poll_media(self):
        media = read_media()
        if media:
            title, artist, status = media
            icon = "󰏤" if status == "Playing" else "󰏥"
            self.media_title.set_label(f"{icon} {title}")
            self.media_artist.set_label(artist if artist else "")
            self.media_box.set_visible(True)
            self.sep1.set_visible(True)
            # Auto-expand when media starts playing
            if self._prev_media is None and not self.expanded:
                self._expand()
            self._prev_media = media
        else:
            self.media_box.set_visible(False)
            self.sep1.set_visible(False)
            self._prev_media = None
        return True

    def _poll_sys(self):
        cpu = read_cpu()
        ram = read_ram()
        self.cpu_label.set_label(f"󰻠 {cpu}%")
        self.ram_label.set_label(f"󰍛 {ram}%")

        bright = read_brightness()
        if bright is not None:
            self.bright_label.set_label(f"󰃞 {bright}%")
            self.bright_label.set_visible(True)
        else:
            self.bright_label.set_visible(False)
        return True

    def _on_destroy(self, *_):
        self.quit()


# ── Main ──────────────────────────────────────────────────────────────

def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    app = DynamicIsland()
    app.run(sys.argv)


if __name__ == "__main__":
    main()
