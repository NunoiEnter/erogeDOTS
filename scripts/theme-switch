#!/usr/bin/env bash
# Render and apply erogeDOTS themes. Interactive screens live in theme-picker.
set -euo pipefail

DOTFILES="${EROGEDOTS_ROOT:-$HOME/erogeDOTS}"
CONFIG_HOME="${EROGEDOTS_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
THEMES_DIR="$DOTFILES/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
STATE_DIR="$CONFIG_HOME/theme"
STATE_FILE="$STATE_DIR/active"
APPS=(niri quickshell fetch fuzzel swaync wlogout ghostty alacritty kitty cava cmatrix bottom)

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info() { printf "${CYAN}→${NC} %s\n" "$*"; }
warn() { printf "${YELLOW}warning:${NC} %s\n" "$*" >&2; }
die() { printf "${RED}error:${NC} %s\n" "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
theme-switch <theme>       render and apply a theme
theme-switch picker        open the theme TUI
theme-switch add           create a theme in the guided TUI
theme-switch list          list themes
theme-switch current       print active theme
theme-switch style [vn|win98]  show or change the desktop style
theme-switch preview [id]  print key colors
EOF
}

available_themes() {
    local dir
    for dir in "$THEMES_DIR"/*/; do
        [[ -f "$dir/theme.conf" ]] && basename "$dir"
    done | sort
}

list_themes() {
    local active theme marker
    active="$(cat "$STATE_FILE" 2>/dev/null || true)"
    while IFS= read -r theme; do
        marker='○'; [[ "$theme" == "$active" ]] && marker='●'
        printf '%s %s\n' "$marker" "$theme"
    done < <(available_themes)
}

declare -A THEME
parse_theme() {
    local conf="$1" line key value
    THEME=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#|\[|$) || "$line" != *'='* ]] && continue
        key="${line%%=*}"; value="${line#*=}"
        key="${key//[[:space:]]/}"
        [[ "$key" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid theme key: $key"
        key="${key^^}"; key="${key//-/_}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ "$value" == \"* ]]; then
            value="$(jq -er 'select(type == "string")' <<< "$value")" || die "invalid string for $key"
        fi
        THEME["$key"]="$value"
    done < "$conf"
}

require_theme() {
    local name="$1" key
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid theme id: $name"
    local conf="$THEMES_DIR/$name/theme.conf"
    [[ -f "$conf" ]] || die "theme not found: $name"
    parse_theme "$conf"
    for key in PRIMARY PRIMARY_LIGHT PRIMARY_DARK BG BG_LIGHT BG_SURFACE FG FG_DIM WALLPAPER; do
        [[ -n "${THEME[$key]:-}" ]] || die "$name misses required key: ${key,,}"
    done
    # Older and newly created themes inherit the romance VN interface palette.
    THEME[VN_PAPER]="${THEME[VN_PAPER]:-#fff9f0}"
    THEME[VN_INK]="${THEME[VN_INK]:-#43394b}"
    THEME[VN_MUTED]="${THEME[VN_MUTED]:-#776477}"
    THEME[VN_ACCENT]="${THEME[VN_ACCENT]:-#995b78}"
    THEME[VN_TINT]="${THEME[VN_TINT]:-#f3dce4}"
    THEME[VN_LINE]="${THEME[VN_LINE]:-#cbb4bf}"
    local style="${EROGEDOTS_STYLE:-$(cat "$STATE_DIR/style" 2>/dev/null || printf vn)}"
    [[ "$style" == vn || "$style" == win98 ]] || die "unknown desktop style: $style"
    THEME[UI_STYLE]="$style"
    THEME[UI_RADIUS]=5
    THEME[UI_CONTROL_RADIUS]=3
    THEME[UI_TITLE_FONT]="Noto Serif JP"
    THEME[UI_BEVEL]="none"
    if [[ "$style" == win98 ]]; then
        THEME[VN_PAPER]="#c0c0c0"
        THEME[VN_INK]="#000000"
        THEME[VN_MUTED]="#404040"
        THEME[VN_ACCENT]="#000080"
        THEME[VN_TINT]="#d6d6d6"
        THEME[VN_LINE]="#808080"
        THEME[NIRI_FOCUS_ACTIVE]="#000080"
        THEME[NIRI_FOCUS_INACTIVE]="#808080"
        THEME[UI_RADIUS]=0
        THEME[UI_CONTROL_RADIUS]=0
        THEME[UI_TITLE_FONT]="Noto Sans"
        THEME[UI_BEVEL]="inset 1px 1px #ffffff, inset -1px -1px #404040"
    fi
    # Metadata is QML source only after JSON escaping (quotes, slashes, newlines).
    for key in CHAR_NAME CHAR_FULL CHAR_GAME; do
        THEME[${key}_JSON]="$(jq -cn --arg value "${THEME[$key]:-}" '$value')"
    done
    THEME[WALLPAPER_PATH_JSON]="$(jq -cn --arg value "$(wallpaper_path)" '$value')"
    THEME[THEME_ID_JSON]="$(jq -cn --arg value "$name" '$value')"
    THEME[CHARACTERS_JSON]="$(character_catalog)"
}

character_catalog() {
    local dir id
    for dir in "$THEMES_DIR"/*/; do
        id="$(basename "$dir")"
        [[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ && -f "$dir/theme.conf" ]] || continue
        (
            parse_theme "$dir/theme.conf"
            [[ -n "${THEME[WALLPAPER]:-}" ]] || exit 0
            jq -cn --arg id "$id" --arg name "${THEME[CHAR_FULL]:-$id}" \
                --arg japanese "${THEME[CHAR_NAME]:-}" --arg game "${THEME[CHAR_GAME]:-}" \
                --arg image "$(wallpaper_path)" --arg accent "${THEME[VN_ACCENT]:-#995b78}" \
                '{id: $id, name: $name, japanese: $japanese, game: $game, image: $image, accent: $accent}'
        )
    done | jq -sc 'sort_by(.id)'
}

wallpaper_path() {
    local path="${THEME[WALLPAPER]}"
    path="${path/#\~/$HOME}"
    [[ "$path" == /* ]] || path="$DOTFILES/$path"
    printf '%s\n' "$path"
}

render_template() {
    local source="$1" target="$2" key escaped rules=""
    for key in "${!THEME[@]}"; do
        escaped="${THEME[$key]//\\/\\\\}"
        escaped="${escaped//&/\\&}"
        escaped="${escaped//|/\\|}"
        escaped="${escaped//$'\n'/\\$'\n'}"
        rules+="s|{{$key}}|$escaped|g"$'\n'
    done
    sed "$rules" "$source" > "$target"
    if grep -Eq '\{\{[A-Z0-9_]+\}\}' "$target"; then
        die "unresolved value in template: ${source#"$DOTFILES/"}"
    fi
}

render_configs() {
    local name="$1" app template
    local cache="$STATE_DIR/cache/$name"
    mkdir -p "$cache"
    for app in "${APPS[@]}"; do
        [[ -d "$TEMPLATES_DIR/$app" ]] || continue
        mkdir -p "$cache/$app"
        for template in "$TEMPLATES_DIR/$app"/*; do
            [[ -f "$template" ]] || continue
            render_template "$template" "$cache/$app/$(basename "$template")"
        done
    done
}

install_configs() {
    local name="$1" app target
    local cache="$STATE_DIR/cache/$name"
    for app in "${APPS[@]}"; do
        [[ -d "$cache/$app" ]] || continue
        target="$CONFIG_HOME/$app"
        [[ ! -L "$target" ]] || die "refusing to overwrite symlink: $target"
        mkdir -p "$target"
        cp -f "$cache/$app"/* "$target/"
    done
}

write_state() {
    local name="$1"
    mkdir -p "$STATE_DIR"
    cat > "$STATE_DIR/env" <<EOF
export THEME_PRIMARY="${THEME[PRIMARY]}"
export THEME_PRIMARY_LIGHT="${THEME[PRIMARY_LIGHT]}"
export THEME_PRIMARY_DARK="${THEME[PRIMARY_DARK]}"
export THEME_BG="${THEME[BG]}"
export THEME_FG="${THEME[FG]}"
export CAVA_COLOR="${THEME[CAVA_COLORS]:-${THEME[PRIMARY]}}"
export CMATRIX_COLOR="${THEME[CMATRIX_COLOR]:-cyan}"
EOF
    printf '%s\n' "$name" > "$STATE_FILE"
    printf '%s\n' "${THEME[UI_STYLE]}" > "$STATE_DIR/style"
}

stop_desktop_shell() {
    local pid attempt
    command -v quickshell >/dev/null || return 0
    # Stop before copying QML: live reload must not see half of a new theme.
    # Read Quickshell's registry instead of matching every quickshell process.
    while read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        kill -TERM "$pid" 2>/dev/null || continue
        for ((attempt = 0; attempt < 20; attempt++)); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.05
        done
    done < <(quickshell list -j -p "$CONFIG_HOME/quickshell/shell.qml" 2>/dev/null | jq -r '.[].pid' 2>/dev/null)
}

reload_desktop() {
    local wallpaper
    wallpaper="$(wallpaper_path)"
    if [[ -f "$wallpaper" ]]; then
        awww img "$wallpaper" --transition-type fade 2>/dev/null || warn "could not apply wallpaper: $wallpaper"
    else
        warn "wallpaper not found: $wallpaper"
    fi
    pgrep -x niri >/dev/null && niri msg action load-config-file >/dev/null 2>&1 || true
    if pgrep -x swaync >/dev/null; then
        swaync-client --reload-config >/dev/null 2>&1 || true
        swaync-client --reload-css >/dev/null 2>&1 || true
    fi
    if command -v quickshell >/dev/null && [[ -f "$CONFIG_HOME/quickshell/shell.qml" ]]; then
        quickshell -d -n -p "$CONFIG_HOME/quickshell/shell.qml" >/dev/null 2>&1 </dev/null
    fi
}

apply_theme() {
    local name="$1"
    info "loading theme: $name"
    require_theme "$name"
    info "rendering configs"
    mkdir -p "$STATE_DIR"
    render_configs "$name"
    info "installing configs"
    [[ "${EROGEDOTS_NO_RESTART:-0}" == 1 ]] || stop_desktop_shell
    install_configs "$name"
    info "saving state"
    write_state "$name"
    rm -f "${XDG_CACHE_HOME:-$HOME/.cache}"/fastfetch-*.out 2>/dev/null || true
    info "reloading desktop"
    [[ "${EROGEDOTS_NO_RESTART:-0}" == 1 ]] || reload_desktop
    printf "${GREEN}✓${NC} theme: %s\n" "$name"
    info "terminal colors update in newly opened terminals"
}

preview() {
    local name="${1:-$(cat "$STATE_FILE" 2>/dev/null || true)}"
    [[ -n "$name" ]] || die "no active theme"
    require_theme "$name"
    printf 'theme       %s\nprimary     %s\nbackground  %s\nforeground  %s\nwallpaper   %s\n' \
        "$name" "${THEME[PRIMARY]}" "${THEME[BG]}" "${THEME[FG]}" "$(wallpaper_path)"
}

case "${1:-help}" in
    picker) exec theme-picker themes ;;
    add) exec theme-picker add ;;
    list) list_themes ;;
    current) cat "$STATE_FILE" 2>/dev/null || printf 'none\n' ;;
    style)
        if [[ -z "${2:-}" ]]; then
            cat "$STATE_DIR/style" 2>/dev/null || printf 'vn\n'
        else
            [[ "$2" == vn || "$2" == win98 ]] || die "style must be vn or win98"
            EROGEDOTS_STYLE="$2" apply_theme "$(cat "$STATE_FILE" 2>/dev/null || printf harumi)"
            if [[ "${3:-}" == --show-menu && "${EROGEDOTS_NO_RESTART:-0}" != 1 ]]; then
                quickshell ipc -p "$CONFIG_HOME/quickshell/shell.qml" call quick-settings open
            fi
        fi
        ;;
    preview) preview "${2:-}" ;;
    help|-h|--help) usage ;;
    *) apply_theme "$1" ;;
esac

if [[ "${2:-}" == --show-menu && "${EROGEDOTS_NO_RESTART:-0}" != 1 ]]; then
    quickshell ipc -p "$CONFIG_HOME/quickshell/shell.qml" call quick-settings page "${3:-characters}"
fi
