#!/usr/bin/env bash
# ram — show where RAM goes on NixChan + safe diet to reclaim it.
# Usage:
#   ram show [--short]   breakdown: free, PSS top, category totals, opencode DB
#   ram diet [--full]    kill safe leftovers; --full also stops codex daemons
#   ram watch            refresh compact view every 2s
# Diet only touches user-owned processes, never sudo, never deletes data.
set -euo pipefail

SHORT=0
FULL=0
CMD="${1:-show}"
for a in "$@"; do
    case "$a" in
        --short) SHORT=1 ;;
        --full) FULL=1 ;;
    esac
done

pss_rows() {
    ps -eo pid=,args= | awk '
        {
            pid=$1; $1=""; args=substr($0, 2); total=0
            path="/proc/" pid "/smaps_rollup"
            while ((getline line < path) > 0) {
                if (line ~ /^Pss:/) { split(line, parts, /[[:space:]]+/); total += parts[2] }
            }
            close(path)
            printf "%.0f %s %s\n", total, pid, args
        }' 2>/dev/null
}

pss_table() {
    pss_rows | sort -nr | awk '{ printf "%6.0f %7s", $1 / 1024, $2; $1=""; $2=""; print substr($0, 1, 112) }'
}

cat_totals() {
    pss_rows | awk '
        BEGIN { split("opencode browser codex desktop bg other", names, " ") }
        {
            memory=$1; $1=""; $2=""; args=tolower($0); group="other"
            if (args ~ /opencode|npm.*mcp|node.*\.bin\/mcp|pg_computer/) group="opencode"
            else if (args ~ /firefox|librewolf|chrome|isolated|web content|socket process|rdd process|utility process|privileged cont|extensions/) group="browser"
            else if (args ~ /codex/) group="codex"
            else if (args ~ /niri|quickshell|xwayland|swaync|awww|mpd|fcitx5|mako|ghostty|kitty|alacritty|fuzzel|discordo/) group="desktop"
            else if (args ~ /blueman|nm-applet|tailscaled|polkit|xdg-desktop-portal|pipewire|wireplumber|upower|gvfs|at-spi|gnome-keyring|playerctl|cliphist|wl-paste/) group="bg"
            totals[group] += memory
        }
        END { for (i=1;i<=6;i++) printf "%-9s %5.0f MB\n", names[i], totals[names[i]]/1024 }'
}

opencode_db() {
    local db="$HOME/.local/share/opencode/opencode-stable.db"
    [[ -f "$db" ]] || { echo "opencode DB: none"; return 0; }
    du -h "$db" | awk '{ print "opencode DB: " $1 " " $2 }'
    if command -v sqlite3 >/dev/null; then
        sqlite3 -readonly "$db" "SELECT 'sessions: ' || (SELECT COUNT(*) FROM session) || '  messages: ' || (SELECT COUNT(*) FROM message) || '  parts: ' || (SELECT COUNT(*) FROM part);" || echo "DB query skipped"
    fi
}

cmd_show() {
    echo "== free =="
    free -h
    echo
    echo "== top PSS (MB PID CMD) =="
    if [[ "$SHORT" == 1 ]]; then
        pss_table | sed -n '1,12p'
    else
        pss_table | sed -n '1,20p'
    fi
    echo
    echo "== categories (PSS, root procs read 0, add ~150MB) =="
    cat_totals
    echo
    echo "== hogs =="
    opencode_db
    echo "== diet hints =="
    echo "firefox tabs dominate idle. close tabs / about:memory minimize."
    echo "opencode TUI ~700MB + MCP children ~200MB. disable idle MCP in opencode.jsonc."
    echo "prune: opencode session list, opencode session delete <id>, opencode db \"VACUUM;\""
    echo "run: ram diet [--full]"
}

cmd_diet() {
    local before after
    before=$(free -m | awk '/^Mem:/ { print $3 }')
    # MCP / pg-computer children whose opencode parent is gone.
    while read -r pid ppid args; do
        if ! kill -0 "$ppid" 2>/dev/null; then
            kill "$pid" 2>/dev/null && echo "killed orphan $pid ($args)" || true
        fi
    done < <(pgrep -a -f "pg_computer.server|node.*/\.bin/mcp|npm exec @magicuidesign" | awk '{ print $1 }' \
        | while read -r pid; do
            ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
            echo "$pid $ppid orphan-mcp"
        done)
    if [[ "$FULL" == 1 ]]; then
        pkill -f "codex app-server" 2>/dev/null \
            && echo "killed codex daemons" || echo "codex: none running"
    else
        echo "tip: ram diet --full also stops codex daemons"
    fi
    sleep 1
    after=$(free -m | awk '/^Mem:/ { print $3 }')
    echo "Mem used: ${before}M -> ${after}M (shared/cache shift, check ram show)"
}

case "$CMD" in
    show) cmd_show ;;
    diet) cmd_diet ;;
    watch)
        while true; do
            clear
            SHORT=1 cmd_show
            sleep 2
        done
        ;;
    *) echo "usage: ram [show [--short]|diet [--full]|watch]" >&2; exit 1 ;;
esac
