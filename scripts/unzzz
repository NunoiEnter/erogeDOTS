#!/usr/bin/env bash
# unzzz: stay awake with lid closed. Blocks logind lid-switch until stopped.
set -euo pipefail

start() {
    systemctl --user stop unzzz.service 2>/dev/null || true
    systemctl --user reset-failed unzzz.service 2>/dev/null || true
    systemd-run --user --unit=unzzz --collect \
        --description="Stay awake with lid closed" \
        /run/current-system/sw/bin/systemd-inhibit \
        --what=handle-lid-switch --mode=block \
        --who=unzzz --why="stay awake, lid closed" \
        /run/current-system/sw/bin/sleep infinity
}

stop() {
    systemctl --user stop unzzz.service
}

case "${1:-start}" in
    stop)
        stop
        ;;
    start)
        start
        ;;
    toggle)
        if systemctl --user is-active --quiet unzzz.service; then
            stop
            notify-send "Stay awake" "Off" 2>/dev/null || true
        else
            start
            notify-send "Stay awake" "On" 2>/dev/null || true
        fi
        ;;
    *)
        printf '%s\n' 'Usage: unzzz [start|stop|toggle]' >&2
        exit 2
        ;;
esac
