#!/usr/bin/env python3
"""Small JSON interface for the desktop's declarative package and config editor."""
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time

ROOT = Path(os.environ.get("EROGEDOTS_ROOT", Path.home() / "erogeDOTS")).resolve()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "erogedots"
FILES = {"nixos": ROOT / "configuration.nix", "home": ROOT / "home/moni.nix",
         "niri": ROOT / "themes/templates/niri/config.kdl"}
PACKAGES = ROOT / "home/desktop-packages.json"
ATTRIBUTE = re.compile(r"[A-Za-z_][A-Za-z0-9_-]*(?:\.[A-Za-z_][A-Za-z0-9_-]*)*")


def run(command, **kwargs):
    result = subprocess.run(command, capture_output=True, text=True, timeout=120, **kwargs)
    if result.returncode:
        raise ValueError((result.stderr or result.stdout).strip()[-2000:] or "Command failed.")
    return result.stdout


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()


def target(name):
    if name not in FILES:
        raise ValueError("Choose NixOS, Home Manager or Niri.")
    path = FILES[name]
    if path.is_symlink() or not path.resolve().is_relative_to(ROOT):
        raise ValueError("The editor cannot replace a file outside this dotfile repository.")
    return path


def write(path, text):
    if path.is_symlink() or not path.resolve().is_relative_to(ROOT):
        raise ValueError("Cannot replace a file outside the repository.")
    backup = STATE / "config-backups" / f"{time.time_ns()}-{path.name}"
    backup.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        shutil.copy2(path, backup)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as temporary:
        temporary.write(text)
        temp_path = Path(temporary.name)
    try:
        temp_path.chmod(path.stat().st_mode & 0o777 if path.exists() else 0o644)
        os.replace(temp_path, path)
    finally:
        temp_path.unlink(missing_ok=True)


def packages():
    values = json.loads(PACKAGES.read_text())
    if not isinstance(values, list) or any(not isinstance(value, str) or not ATTRIBUTE.fullmatch(value) for value in values):
        raise ValueError("The package list must contain Nix package names.")
    return values


def niri_settings(text):
    def number(pattern):
        match = re.search(pattern, text)
        if not match:
            raise ValueError("This Niri file needs manual editing; the layout controls were not found.")
        return float(match[1])
    return {"gaps": number(r"\bgaps\s+(\d+)"),
            "focusWidth": number(r"focus-ring\s*\{\s*width\s+(\d+)"),
            "columnWidth": round(number(r"default-column-width\s*\{\s*proportion\s+([\d.]+)") * 100)}


def status():
    hostname = socket.gethostname()
    try:
        settings = niri_settings(FILES["niri"].read_text())
    except ValueError:
        settings = None
    return {"packages": packages(), "hostname": hostname,
            "hostAvailable": (ROOT / "hosts" / hostname / "hardware-configuration.nix").is_file(),
            "niri": settings}


def validate_niri(text):
    # Render the candidate in isolation, using the existing renderer and active palette.
    with tempfile.TemporaryDirectory(prefix="vn-config-") as directory:
        sandbox = Path(directory)
        themes = sandbox / "themes"
        (themes / "templates/niri").mkdir(parents=True)
        (themes / "templates/niri/config.kdl").write_text(text)
        for theme in (ROOT / "themes").iterdir():
            if theme.is_dir() and (theme / "theme.conf").is_file():
                (themes / theme.name).symlink_to(theme, target_is_directory=True)
        active = (CONFIG / "theme/active").read_text().strip()
        style_path = CONFIG / "theme/style"
        style = style_path.read_text().strip() if style_path.exists() else "vn"
        rendered = sandbox / "config"
        env = dict(os.environ, EROGEDOTS_ROOT=str(sandbox), EROGEDOTS_CONFIG_HOME=str(rendered),
                   EROGEDOTS_NO_RESTART="1", EROGEDOTS_STYLE=style)
        run([str(ROOT / "scripts/theme-switch"), active], env=env)
        run(["niri", "validate", "--config", str(rendered / "niri/config.kdl")])


def validate(name, text):
    if len(text.encode()) > 512000:
        raise ValueError("This editor accepts files up to 500 KB.")
    if name == "niri":
        validate_niri(text)
    else:
        with tempfile.NamedTemporaryFile(mode="w", suffix=".nix") as candidate:
            candidate.write(text)
            candidate.flush()
            run(["nix-instantiate", "--parse", candidate.name])


def dispatch(request):
    operation = request.get("operation")
    if operation == "status":
        return {"status": status()}
    if operation == "read":
        path = target(request.get("target"))
        text = path.read_text()
        return {"text": text, "version": digest(text), "target": request["target"], "path": str(path)}
    if operation == "save":
        name = request.get("target")
        path = target(name)
        if digest(path.read_text()) != request.get("version"):
            raise ValueError("This file changed elsewhere. Reload it before saving.")
        text = request.get("text")
        if not isinstance(text, str):
            raise ValueError("File content is missing.")
        validate(name, text)
        if digest(path.read_text()) != request.get("version"):
            raise ValueError("This file changed during validation. Reload it before saving.")
        write(path, text)
        return {"version": digest(text), "status": status(), "message": "Saved and validated. Apply Niri or Apply NixOS to activate your changes."}
    if operation in ("add", "remove"):
        name = request.get("package", "")
        if not isinstance(name, str) or not ATTRIBUTE.fullmatch(name):
            raise ValueError("Use a package name such as ripgrep or kdePackages.kate.")
        values = packages()
        if operation == "add":
            locked = json.loads((ROOT / "flake.lock").read_text())["nodes"]["nixpkgs"]["locked"]
            url = f'github:{locked["owner"]}/{locked["repo"]}/{locked["rev"]}'
            expression = f'let p = import (builtins.getFlake {json.dumps(url)}).outPath {{ system = builtins.currentSystem; config.allowUnfree = true; }}; in if (p.{name}.type or "") == "derivation" then (p.{name}.pname or p.{name}.name) else throw "Choose an installable package"'
            run(["nix", "eval", "--raw", "--impure", "--expr", expression])
            values = sorted(set(values + [name]))
        else:
            values = [value for value in values if value != name]
        write(PACKAGES, json.dumps(values, indent=2) + "\n")
        return {"status": status(), "message": "Package list saved. Apply NixOS to install or remove these extra packages."}
    if operation == "niri-settings":
        path = target("niri")
        text = path.read_text()
        niri_settings(text)  # Only edit the supported layout entries.
        values = [("gaps", 0, 64), ("focusWidth", 0, 12), ("columnWidth", 20, 100)]
        for key, low, high in values:
            value = request.get(key)
            if isinstance(value, bool) or not isinstance(value, (int, float)) or not low <= value <= high or int(value) != value:
                raise ValueError(f"Invalid {key} value.")
        text = re.sub(r"(\bgaps\s+)\d+", lambda match: match[1] + str(int(request["gaps"])), text, count=1)
        text = re.sub(r"(focus-ring\s*\{\s*width\s+)\d+", lambda match: match[1] + str(int(request["focusWidth"])), text, count=1)
        text = re.sub(r"(default-column-width\s*\{\s*proportion\s+)[\d.]+", lambda match: match[1] + str(request["columnWidth"] / 100), text, count=1)
        validate_niri(text)
        write(path, text)
        return {"status": status(), "message": "Niri settings saved and validated. Use Apply Niri to activate them."}
    raise ValueError("Unknown desktop configuration action.")


@contextlib.contextmanager
def build_source():
    # Include edited and new files, excluding ignored build artifacts and .git.
    paths = subprocess.check_output(["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"]).decode().split("\0")
    with tempfile.TemporaryDirectory(prefix="erogedots-build-") as directory:
        stage = Path(directory)
        for name in filter(None, paths):
            source = ROOT / name
            if not source.is_file():
                continue
            destination = stage / name
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
        yield stage


def terminal_action(action):
    if action == "apply-niri":
        active = (CONFIG / "theme/active").read_text().strip()
        os.execv(str(ROOT / "scripts/theme-switch"), ["theme-switch", active, "--show-menu", "workshop"])
    if action not in ("check", "rebuild"):
        raise ValueError("Unknown terminal action.")
    host = socket.gethostname()
    if not (ROOT / "hosts" / host / "hardware-configuration.nix").is_file():
        raise ValueError(f"No NixOS host configuration exists for {host}.")
    with build_source() as stage:
        if action == "check":
            command = ["nix", "flake", "check", f"path:{stage}", "--no-build", "--no-write-lock-file"]
        else:
            command = ["sudo", "nixos-rebuild", "switch", "--flake", f"path:{stage}#{host}", "--no-write-lock-file"]
        return subprocess.call(command)


if __name__ == "__main__":
    try:
        if len(sys.argv) > 1:
            sys.exit(terminal_action(sys.argv[1]))
        STATE.mkdir(parents=True, exist_ok=True)
        with (STATE / "desktop-config.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            response = dispatch(json.loads(sys.stdin.readline()))
        print(json.dumps({"ok": True, **response}))
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "error": str(error)}))
        sys.exit(1)
