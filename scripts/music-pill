#!/usr/bin/env python3
"""
erogeDOTS Music Pill — floating GTK4 overlay with MPRIS + lyrics.

Modes:
  compact   – album art circle + scrolling title + play/pause
  expanded  – compact + prev/next + volume slider
  lyrics    – expanded + timed lyrics below

Auto-hides when nothing is playing.
Left-click  = toggle compact/expanded
Right-click = toggle lyrics
Middle-click / scroll = volume ±5%
"""

import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.request import Request, urlopen
from urllib.error import URLError

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell
    HAS_LAYER_SHELL = True
except (ImportError, ValueError):
    HAS_LAYER_SHELL = False

# ── D-Bus / MPRIS via subprocess ───────────────────────────────

def _dbus_call(interface, method, *args):
    """Call an MPRIS method via dbus-send."""
    cmd = ["dbus-send", "--session", "--type=method_call",
           "--dest=org.mpris.MediaPlayer2.%s" % _player_name(),
           "/org/mpris/MediaPlayer2",
           "org.mpris.MediaPlayer2.Player.%s" % method]
    for a in args:
        cmd.append(str(a))
    try:
        subprocess.run(cmd, capture_output=True, timeout=2)
    except Exception:
        pass

def _dbus_get(interface, prop):
    """Get an MPRIS property via dbus-send --print-reply."""
    cmd = ["dbus-send", "--session", "--type=method_call", "--print-reply",
           "--dest=org.mpris.MediaPlayer2.%s" % _player_name(),
           "/org/mpris/MediaPlayer2",
           "org.freedesktop.DBus.Properties.Get",
           "string:org.mpris.MediaPlayer2.Player",
           "string:%s" % prop]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
        return r.stdout
    except Exception:
        return ""

def _player_name():
    """Get active MPRIS player name from playerctl."""
    try:
        r = subprocess.run(["playerctl", "-l", "-f", "{{playerInstance}}"],
                           capture_output=True, text=True, timeout=2)
        names = [n.strip() for n in r.stdout.strip().split("\n") if n.strip()]
        if names:
            return names[0]
    except Exception:
        pass
    return "generic"

def _get_metadata():
    """Return (title, artist, album, art_url, length_sec, track_id)."""
    try:
        # Use playerctl for reliable metadata
        fmt = "{{title}}\x00{{artist}}\x00{{album}}\x00{{mpris:artUrl}}\x00{{duration(microseconds)}}\x00{{mpris:trackId}}"
        r = subprocess.run(["playerctl", "-f", fmt, "metadata"],
                           capture_output=True, text=True, timeout=2)
        parts = r.stdout.strip().split("\x00")
        while len(parts) < 6:
            parts.append("")
        title, artist, album, art_url, dur_us, track_id = parts[:6]
        length = int(dur_us) / 1_000_000 if dur_us.isdigit() else 0
        return title, artist, album, art_url, length, track_id
    except Exception:
        return "", "", "", "", 0, ""

def _get_playback_status():
    try:
        r = subprocess.run(["playerctl", "status"],
                           capture_output=True, text=True, timeout=2)
        return r.stdout.strip()
    except Exception:
        return "Stopped"

def _get_position():
    """Position in seconds."""
    try:
        r = subprocess.run(["playerctl", "position"],
                           capture_output=True, text=True, timeout=2)
        return float(r.stdout.strip())
    except Exception:
        return 0.0

def _get_volume():
    try:
        out = _dbus_get("org.mpris.MediaPlayer2.Player", "Volume")
        # Volume is a double in the reply
        for line in out.split("\n"):
            line = line.strip()
            if "double" in line:
                val = line.split("double")[-1].strip().strip('"')
                return float(val)
    except Exception:
        pass
    return 0.5

# ── LRCLIB lyrics ──────────────────────────────────────────────

_lyrics_cache = {}  # track_id -> [(start_sec, text), ...]

def _fetch_lyrics(title, artist, album, track_id, length):
    """Fetch synced lyrics from LRCLIB."""
    if track_id in _lyrics_cache:
        return _lyrics_cache[track_id]
    if not title:
        return []
    try:
        params = {"track_name": title, "artist_name": artist, "album_name": album}
        if length > 0:
            params["duration"] = int(length)
        query = "&".join(f"{k}={v}" for k, v in params.items() if v)
        url = f"https://lrclib.net/api/get?{query}"
        req = Request(url, headers={"User-Agent": "erogeDOTS/1.0 (music-pill)"})
        resp = urlopen(req, timeout=5)
        data = json.loads(resp.read())
        synced = data.get("syncedLyrics", "")
        if not synced:
            return []
        lines = []
        for line in synced.split("\n"):
            if line.startswith("[") and "]" in line:
                ts, txt = line[1:].split("]", 1)
                mins, secs = ts.split(":")
                t = int(mins) * 60 + float(secs)
                lines.append((t, txt.strip()))
        _lyrics_cache[track_id] = lines
        return lines
    except (URLError, json.JSONDecodeError, Exception):
        _lyrics_cache[track_id] = []
        return []

def _get_current_lyric(lyrics, position):
    """Return the current lyric line text."""
    if not lyrics:
        return "♪ ♫ ♪ ♫ ♪"
    current = ""
    for start, text in lyrics:
        if position >= start:
            current = text
        else:
            break
    return current if current else ""

# ── Album art ───────────────────────────────────────────────────

def _load_album_art(art_url, size=32):
    """Return a Gtk.Texture from the album art file, or None."""
    if not art_url or not art_url.startswith("file://"):
        return None
    path = art_url[7:]
    if not os.path.exists(path):
        return None
    try:
        return Gdk.Texture.new_from_filename(path)
    except Exception:
        return None

# ── CSS ─────────────────────────────────────────────────────────

CSS = b"""
.pill {
    background: rgba(22, 22, 32, 0.85);
    border-radius: 20px;
    padding: 6px 12px;
    transition: all 300ms ease;
}
.pill:hover {
    background: rgba(28, 28, 42, 0.92);
}
.title {
    color: #e8a0bf;
    font-size: 12px;
    font-weight: 600;
}
.artist {
    color: #b48ead;
    font-size: 10px;
}
.separator {
    color: #565669;
    font-size: 10px;
}
.play-btn {
    color: #c8a0e8;
    font-size: 16px;
    padding: 2px 6px;
    background: transparent;
    border: none;
    border-radius: 10px;
}
.play-btn:hover {
    background: rgba(200, 160, 232, 0.15);
}
.ctrl-btn {
    color: #7a7a9a;
    font-size: 12px;
    padding: 2px 4px;
    background: transparent;
    border: none;
    border-radius: 8px;
}
.ctrl-btn:hover {
    color: #e8a0bf;
    background: rgba(232, 160, 191, 0.1);
}
.lyrics-label {
    color: #c8a0e8;
    font-size: 11px;
    font-style: italic;
    padding: 4px 8px;
}
.volume-label {
    color: #7a7a9a;
    font-size: 10px;
}
"""

# ── Main widget ─────────────────────────────────────────────────

class MusicPill(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.eroge.MusicPill")
        self.mode = "compact"  # compact | expanded | lyrics
        self._last_track = None
        self._lyrics = []
        self._timeout_id = None

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # ── Layer shell ──
        self.win = Gtk.ApplicationWindow(application=self)
        self.win.set_default_size(200, 36)
        self.win.set_decorated(False)

        if HAS_LAYER_SHELL:
            Gtk4LayerShell.init_for_window(self.win)
            Gtk4LayerShell.set_layer(self.win, Gtk4LayerShell.Layer.TOP)
            Gtk4LayerShell.set_namespace(self.win, "eroge-music-pill")
            Gtk4LayerShell.set_anchor(self.win, Gtk4LayerShell.Edge.TOP, True)
            Gtk4LayerShell.set_anchor(self.win, Gtk4LayerShell.Edge.LEFT, True)
            Gtk4LayerShell.set_anchor(self.win, Gtk4LayerShell.Edge.RIGHT, True)
            Gtk4LayerShell.set_margin(self.win, Gtk4LayerShell.Edge.TOP, 8)

        # ── Main box ──
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.win.set_child(self.main_box)

        # ── Pill row ──
        self.pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.pill.add_css_class("pill")

        # Album art placeholder
        self.art_box = Gtk.Box()
        self.art_box.set_size_request(32, 32)
        self.art_box.set_margin_end(4)
        self.pill.append(self.art_box)

        # Text box
        self.text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.title_label = Gtk.Label(label="Nothing playing")
        self.title_label.add_css_class("title")
        self.title_label.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        self.title_label.set_max_width_chars(25)
        self.title_label.set_xalign(0)
        self.text_box.append(self.title_label)

        self.artist_label = Gtk.Label(label="")
        self.artist_label.add_css_class("artist")
        self.artist_label.set_ellipsize(3)
        self.artist_label.set_max_width_chars(25)
        self.artist_label.set_xalign(0)
        self.text_box.append(self.artist_label)
        self.pill.append(self.text_box)

        self.sep = Gtk.Label(label="·")
        self.sep.add_css_class("separator")
        self.pill.append(self.sep)

        # Play button
        self.play_btn = Gtk.Button(label="▶")
        self.play_btn.add_css_class("play-btn")
        self.play_btn.connect("clicked", self._on_play)
        self.pill.append(self.play_btn)

        # Expanded controls (hidden by default)
        self.ctrl_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.ctrl_box.set_visible(False)

        self.prev_btn = Gtk.Button(label="⏮")
        self.prev_btn.add_css_class("ctrl-btn")
        self.prev_btn.connect("clicked", lambda *_: subprocess.run(["playerctl", "previous"]))
        self.ctrl_box.append(self.prev_btn)

        self.next_btn = Gtk.Button(label="⏭")
        self.next_btn.add_css_class("ctrl-btn")
        self.next_btn.connect("clicked", lambda *_: subprocess.run(["playerctl", "next"]))
        self.ctrl_box.append(self.next_btn)

        self.vol_label = Gtk.Label(label="🔊")
        self.vol_label.add_css_class("volume-label")
        self.ctrl_box.append(self.vol_label)

        self.vol_adj = Gtk.Adjustment(lower=0, upper=1, value=0.5, step_increment=0.05)
        self.vol_scale = Gtk.Scale.new(orientation=Gtk.Orientation.HORIZONTAL, adjustment=self.vol_adj)
        self.vol_scale.set_size_request(60, -1)
        self.vol_scale.connect("value-changed", self._on_volume)
        self.ctrl_box.append(self.vol_scale)

        self.pill.append(self.ctrl_box)

        # ── Lyrics row ──
        self.lyrics_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.lyrics_box.set_visible(False)
        self.lyrics_box.set_margin_top(4)

        self.lyrics_label = Gtk.Label(label="")
        self.lyrics_label.add_css_class("lyrics-label")
        self.lyrics_label.set_ellipsize(3)
        self.lyrics_label.set_max_width_chars(40)
        self.lyrics_label.set_xalign(0.5)
        self.lyrics_box.append(self.lyrics_label)

        self.main_box.append(self.pill)
        self.main_box.append(self.lyrics_box)

        # ── Events ──
        click_gesture = Gtk.GestureClick.new()
        click_gesture.connect("pressed", self._on_click)
        self.pill.add_controller(click_gesture)

        lyrics_gesture = Gtk.GestureClick.new()
        lyrics_gesture.connect("pressed", self._on_click)
        self.lyrics_box.add_controller(lyrics_gesture)

        # ── Poll ──
        self._tick()
        self._timeout_id = GLib.timeout_add(1000, self._tick)

    def _on_click(self, gesture, n_press, x, y):
        btn = gesture.get_current_button()
        if btn == 1:  # left
            if self.mode == "compact":
                self.mode = "expanded"
                self.ctrl_box.set_visible(True)
                self.vol_adj.set_value(_get_volume())
                self.win.set_default_size(360, 36)
            else:
                self.mode = "compact"
                self.ctrl_box.set_visible(False)
                self.lyrics_box.set_visible(False)
                self.win.set_default_size(200, 36)
        elif btn == 3:  # right
            if self.mode == "lyrics":
                self.mode = "expanded"
                self.lyrics_box.set_visible(False)
                self.win.set_default_size(360, 36)
            else:
                self.mode = "lyrics"
                self.lyrics_box.set_visible(True)
                self.win.set_default_size(360, 60)
        elif btn == 2:  # middle
            subprocess.run(["playerctl", "play-pause"])

    def _on_play(self, *_):
        subprocess.run(["playerctl", "play-pause"])

    def _on_volume(self, adj):
        vol = adj.get_value()
        subprocess.run(["playerctl", "volume", str(vol)])

    def _tick(self):
        status = _get_playback_status()
        title, artist, album, art_url, length, track_id = _get_metadata()
        playing = status == "Playing"

        # Update play button
        self.play_btn.set_label("⏸" if playing else "▶")

        # No player
        if status == "Stopped" and not title:
            self.win.set_visible(False)
            return True

        self.win.set_visible(True)

        # Track changed → clear lyrics cache
        if track_id != self._last_track:
            self._last_track = track_id
            self._lyrics = []
            if title:
                self._lyrics = _fetch_lyrics(title, artist, album, track_id, length)

        # Update labels
        if title:
            display = title
            if artist:
                display = f"{title} — {artist}"
            self.title_label.set_text(display)
            self.title_label.set_tooltip_text(f"{title}\n{artist}\n{album}")
        else:
            self.title_label.set_text("Nothing playing")
        self.artist_label.set_text(artist or "")

        # Lyrics
        if self.mode == "lyrics" and self._lyrics:
            pos = _get_position()
            lyric = _get_current_lyric(self._lyrics, pos)
            self.lyrics_label.set_text(lyric)
            self.lyrics_label.set_tooltip_text("")
        elif self.mode == "lyrics":
            self.lyrics_label.set_text("♪ ♫ ♪ ♫ ♪")

        return True

def main():
    app = MusicPill()
    app.run(sys.argv)

if __name__ == "__main__":
    main()
