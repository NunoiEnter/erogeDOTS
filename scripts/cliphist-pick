#!/usr/bin/env bash
# cliphist-pick — pick from clipboard history, paste text or image correctly
# images need wl-copy --type <mime>; text must NOT get a type flag

item="$(cliphist list | fuzzel --dmenu)" || exit 1

# Only binary entries (cliphist marks them "[[ binary data ... ]]") carry an image type.
mime=""
if [[ "$item" == *"[[ binary data"* ]]; then
    case "$item" in
        *" png "*)          mime="image/png" ;;
        *" jpg "*|*" jpeg "*) mime="image/jpeg" ;;
        *" webp "*)         mime="image/webp" ;;
        *" gif "*)          mime="image/gif" ;;
    esac
fi

if [[ -n "$mime" ]]; then
    printf '%s\n' "$item" | cliphist decode | wl-copy --type "$mime"
else
    printf '%s\n' "$item" | cliphist decode | wl-copy
fi
